@model IReadOnlyList<Loan>
@{
    ViewData["Title"] = "Front desk";
    var overdue = ViewData["Overdue"] as IReadOnlyList<Loan> ?? Array.Empty<Loan>();
    var recent = ViewData["Recent"] as IReadOnlyList<Loan> ?? Array.Empty<Loan>();
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h2 mb-1">Front desk</h1>
        <p class="text-muted mb-0">@ViewData["LendingTerms"]</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-primary" asp-action="Borrow">Borrow an item</a>
        <a class="btn btn-outline-primary" asp-action="Return">Return an item</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="stat-tile">
            <span class="stat-number">@Model.Count</span>
            <span class="stat-label">items out</span>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-tile @(overdue.Count > 0 ? "stat-alert" : "")">
            <span class="stat-number">@overdue.Count</span>
            <span class="stat-label">overdue</span>
        </div>
    </div>
</div>

@if (overdue.Any())
{
    <h2 class="h5">Overdue now</h2>
    <div class="table-responsive mb-4">
        <table class="table table-sm align-middle">
            <thead>
            <tr>
                <th scope="col">Item</th>
                <th scope="col">Member</th>
                <th scope="col">Due</th>
                <th scope="col">Days late</th>
                <th scope="col" class="text-end">Action</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var loan in overdue)
            {
                <tr>
                    <td>@loan.Item?.Name <span class="code-line">@loan.Item?.LibraryCode</span></td>
                    <td>
                        <a asp-controller="Borrowers" asp-action="Details" asp-route-id="@loan.BorrowerId">
                            @loan.Borrower?.FullName
                        </a>
                    </td>
                    <td>@loan.DueOn.ToString("d MMM yyyy")</td>
                    <td><span class="status status-damaged">@loan.DaysOverdue(DateTime.Today) days</span></td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary"
                           asp-action="Return" asp-route-libraryCode="@loan.Item?.LibraryCode">Take return</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

<h2 class="h5">Everything currently out</h2>
@if (!Model.Any())
{
    <div class="empty-state">
        <p class="mb-0 text-muted">Nothing is on loan at the moment.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
            <tr>
                <th scope="col">Item</th>
                <th scope="col">Type</th>
                <th scope="col">Member</th>
                <th scope="col">Borrowed</th>
                <th scope="col">Due</th>
                <th scope="col" class="text-end">Action</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var loan in Model)
            {
                <tr>
                    <td>@loan.Item?.Name <span class="code-line">@loan.Item?.LibraryCode</span></td>
                                        <td>@loan.Item?.ItemType</td>
                    <td>
                        <a asp-controller="Borrowers" asp-action="Details" asp-route-id="@loan.BorrowerId">
                            @loan.Borrower?.FullName
                        </a>
                    </td>
                    <td>@loan.BorrowedOn.ToString("d MMM")</td>
                    <td>@loan.DueOn.ToString("d MMM yyyy")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary"
                           asp-action="Return" asp-route-libraryCode="@loan.Item?.LibraryCode">Take return</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@if (recent.Any())
{
    <h2 class="h5 mt-4">Recent activity</h2>
    <ul class="activity-list">
        @foreach (var loan in recent)
        {
            <li>
                @if (loan.ReturnedOn.HasValue)
                {
                    <span>@loan.ReturnedOn.Value.ToString("d MMM"): @loan.Item?.Name returned by @loan.Borrower?.FullName</span>
                    @if (loan.FineAmount > 0)
                    {
                        <span class="status @(loan.FinePaid ? "status-available" : "status-damaged") ms-2">
                            @loan.FineAmount.ToString("C") @(loan.FinePaid ? "paid" : "owing")
                        </span>
                    }
                }
                else
                {
                    <span>@loan.BorrowedOn.ToString("d MMM"): @loan.Item?.Name borrowed by @loan.Borrower?.FullName</span>
                }
            </li>
        }
    </ul>
}

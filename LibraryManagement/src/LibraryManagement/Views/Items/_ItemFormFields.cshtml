@model ItemFormViewModel
@*
    Shared by Create and Edit. The type specific blocks are all rendered and then
    shown or hidden by the small script at the bottom of the form, so a validation
    failure never loses what was typed.
*@
<div asp-validation-summary="ModelOnly" class="alert alert-warning" role="alert"></div>

<div class="row g-3">
    <div class="col-md-4">
        <label asp-for="Kind" class="form-label"></label>
        @if (Model.IsExisting)
        {
            <input class="form-control" value="@Model.Kind" disabled />
            <input type="hidden" asp-for="Kind" />
            <div class="form-text">An item cannot change type once it exists.</div>
        }
        else
        {
            <select asp-for="Kind" asp-items="Html.GetEnumSelectList<ItemKind>()" class="form-select" id="itemKind"></select>
        }
    </div>

    <div class="col-md-4">
        <label asp-for="LibraryCode" class="form-label"></label>
        <input asp-for="LibraryCode" class="form-control" placeholder="BK-0005" />
        <span asp-validation-for="LibraryCode" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<ItemStatus>()" class="form-select"></select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="BranchId" class="form-label"></label>
        @if (Model.IsExisting)
        {
            @* Stock moves between branches through a transfer, never by editing a
               dropdown, so that the shelves and the loan history cannot disagree. *@
            <input class="form-control" value="@Model.BranchName" disabled />
            <input type="hidden" asp-for="BranchId" />
            <input type="hidden" asp-for="OwningBranchId" />
            <div class="form-text">
                Raise a <a asp-controller="Transfers" asp-action="Request">transfer</a> to move this item.
            </div>
        }
        else
        {
            <select asp-for="BranchId" class="form-select">
                <option value="">Choose a branch</option>
                @foreach (var branch in Model.Branches)
                {
                    <option value="@branch.Id">@branch.DisplayName</option>
                }
            </select>
            <span asp-validation-for="BranchId" class="text-danger"></span>
        }
    </div>

    <div class="col-12">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
</div>

<fieldset class="kind-fields mt-4" data-kind="Book">
    <legend class="h6">Book details</legend>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Author" class="form-label"></label>
            <input asp-for="Author" class="form-control" />
            <span asp-validation-for="Author" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Genre" class="form-label"></label>
            <input asp-for="Genre" class="form-control" />
            <span asp-validation-for="Genre" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="YearPublished" class="form-label"></label>
            <input asp-for="YearPublished" class="form-control" type="number" />
            <span asp-validation-for="YearPublished" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Isbn" class="form-label"></label>
            <input asp-for="Isbn" class="form-control" />
            <span asp-validation-for="Isbn" class="text-danger"></span>
        </div>
    </div>
</fieldset>


@model Item
@{
    ViewData["Title"] = $"Delete {Model.Name}";
}

<h1 class="h2 mb-3">Delete this item?</h1>

<div class="alert alert-warning">
    Deleting removes the item from the catalogue for good. If it has been borrowed before,
    mark it as destroyed instead so the manager's reports stay accurate.
</div>

<div class="info-card mb-4">
    <dl class="row detail-list mb-0">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>
        <dt class="col-sm-3">Type</dt>
        <dd class="col-sm-9">@Model.ItemType</dd>
        <dt class="col-sm-3">Library code</dt>
        <dd class="col-sm-9"><span class="code-line">@Model.LibraryCode</span></dd>
        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9"><partial name="_StatusBadge" model="Model.Status" /></dd>
        <dt class="col-sm-3">Times borrowed</dt>
        <dd class="col-sm-9">@Model.Loans.Count</dd>
    </dl>
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
    <button type="submit" class="btn btn-danger">Delete permanently</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Keep it</a>
</form>

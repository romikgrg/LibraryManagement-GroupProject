@model Item
@{
    ViewData["Title"] = Model.Name;
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <span class="kind-tag">@Model.ItemType</span>
        <h1 class="h2 mt-2 mb-1">@Model.Name</h1>
        <p class="text-muted mb-0">@Model.Summary</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="info-card">
            <dl class="row detail-list mb-0">
                <dt class="col-sm-5">Library code</dt>
                <dd class="col-sm-7"><span class="code-line">@Model.LibraryCode</span></dd>
                <dt class="col-sm-5">Status</dt>
                <dd class="col-sm-7"><partial name="_StatusBadge" model="Model.Status" /></dd>
                <dt class="col-sm-5">Added on</dt>
                <dd class="col-sm-7">@Model.AddedOn.ToString("d MMM yyyy")</dd>
                <dt class="col-sm-5">Times borrowed</dt>
                <dd class="col-sm-7">@Model.Loans.Count</dd>
            </dl>
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <hr />
                <p class="mb-0 small">@Model.Description</p>
            }
        </div>
    </div>

    <div class="col-lg-7">
        <h2 class="h5">Borrowing history</h2>
        @if (!Model.Loans.Any())
        {
            <div class="empty-state">
                <p class="mb-0 text-muted">This item has not been borrowed yet.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                    <tr>
                        <th scope="col">Borrowed</th>
                        <th scope="col">Member</th>
                        <th scope="col">Due</th>
                        <th scope="col">Returned</th>
                        <th scope="col" class="text-end">Fine</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var loan in Model.Loans)
                    {
                        <tr>
                            <td>@loan.BorrowedOn.ToString("d MMM yyyy")</td>
                            <td>@(loan.Borrower?.FullName ?? "Unknown")</td>
                            <td>@loan.DueOn.ToString("d MMM yyyy")</td>
                            <td>@(loan.ReturnedOn?.ToString("d MMM yyyy") ?? "Still out")</td>
                            <td class="text-end">@(loan.FineAmount > 0 ? loan.FineAmount.ToString("C") : "-")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

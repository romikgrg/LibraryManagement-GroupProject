@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject LibraryManagement.Services.IBranchContext BranchContext
@{
    var currentUser = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
    // Staff need to know at a glance which location this instance is serving,
    // because the same build runs at every branch.
    var deploymentBranch = await BranchContext.GetDeploymentBranchAsync();
}
<!DOCTYPE html>
<html lang="en-AU">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Darwin Community Library</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg navbar-dark bg-ink">
        <div class="container">
            <a class="navbar-brand" asp-controller="Catalogue" asp-action="Index">
                Darwin Community Library
                @if (deploymentBranch is not null)
                {
                    <span class="branch-chip">@deploymentBranch.Code</span>
                }
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Show menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Catalogue" asp-action="Index">Search the catalogue</a>
                    </li>
                    @if (User.IsInRole(Roles.Admin))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Items" asp-action="Index">Collection</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Branches" asp-action="Index">Branches</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Import" asp-action="Index">Import</a>
                        </li>
                    }
                    @if (User.IsInRole(Roles.Reception))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Circulation" asp-action="Index">Front desk</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Reservations" asp-action="Index">Holds</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Transfers" asp-action="Index">Transfers</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Borrowers" asp-action="Index">Members</a>
                        </li>
                    }
                    @if (User.IsInRole(Roles.Manager))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Manager" asp-action="Index">Reports</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Manager" asp-action="Inventory">Inventory</a>
                        </li>
                    }
                    @if (User.IsInRole(Roles.Reception) || User.IsInRole(Roles.Manager))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Notifications" asp-action="Index">Notices</a>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <li class="nav-item d-flex align-items-center me-3">
                            <span class="navbar-text small">
                                @(currentUser?.FullName ?? User.Identity!.Name)
                            </span>
                        </li>
                        <li class="nav-item">
                            <form asp-area="Identity" asp-page="/Account/Logout"
                                  asp-route-returnUrl="@Url.Action("Index", "Catalogue")" method="post">
                                <button type="submit" class="btn btn-outline-light btn-sm">Sign out</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="btn btn-outline-light btn-sm" asp-area="Identity" asp-page="/Account/Login">Staff sign in</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>

<main class="container py-4">
    <partial name="_Flash" />
    @RenderBody()
</main>

<footer class="border-top mt-5 py-4 bg-sand">
    <div class="container small text-muted d-flex flex-wrap justify-content-between gap-2">
        <span>
            Darwin Community Library &middot; catalogue open to everyone
            @if (deploymentBranch is not null)
            {
                <text>&middot; @deploymentBranch.Name</text>
            }
        </span>
        <span>HIT339 Distributed Development &middot; Group Project</span>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@{
    // The kiosk runs unattended on a touch screen bolted to a plinth. It gets its
    // own layout rather than the site one because almost everything in the site
    // chrome is wrong here: there is no sign-in, no navigation to anywhere else,
    // and nothing a patron could use to wander off into staff screens. Large type
    // and large targets are the whole design.
    var branch = ViewBag.KioskBranch as Branch;
}
<!DOCTYPE html>
<html lang="en-AU">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Library self service</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/kiosk.css" asp-append-version="true" />
</head>
<body class="kiosk">
<header class="kiosk-header">
    <a class="kiosk-brand" asp-controller="Kiosk" asp-action="Index">
        Darwin Community Library
    </a>
    @if (branch is not null)
    {
        <span class="kiosk-branch">@branch.Name</span>
    }
</header>

<main class="kiosk-main">
    @RenderBody()
</main>

<footer class="kiosk-footer">
    <a class="kiosk-home" asp-controller="Kiosk" asp-action="Index">Start again</a>
    <span>Need a hand? Ask at the desk.</span>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
